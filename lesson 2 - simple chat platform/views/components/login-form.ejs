<form class="login-form" id="form" onsubmit="handleLoginSubmit(event)" action="/api/login" method="post">
    <section class="user-sec">
        <label class="form-label" for="username">User Name:</label>
        <input class="form-input" type="text" name="username" id="username" required>
    </section>

    <section class="pass-sec">
        <label class="form-label" for="password">Password:</label>
        <input class="form-input" type="password" name="password" id="password" required>
    </section>

    <section class="login-sec">
        <input class="btn" type="submit" value="Login">
    </section>
</form>

<script src="/form/login.js"></script>