<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="style.css">
    <title>Document</title>
</head>

<body>
    <%- include("components/header") %>

    <!-- hello section -->
    <section>
        <h1>Hello</h1>
        <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Aspernatur accusamus inventore mollitia! Earum
            tenetur
            delectus aut recusandae, blanditiis quod vel cupiditate reprehenderit nostrum officiis praesentium ea
            accusamus
            non harum possimus.</p>
    </section>

    <!-- login section -->
    <section>
        <h2>لاگین کردی ها؟</h2>
        <br>
        <% if(is_login) { %>
            <input type="button" class="btn logout">خروج</input>
        <% } else { %>
            <div class="form-div">
                <%- include("components/login-form") %>

                <%- include("components/register-form") %>
            </div>

            <div class="forms-toggle" onclick="handleFormchanger()">
                <span class="form-toggle" id="register-toggle">Register</span>
                <span class="form-toggle" id="login-toggle" style="display: none;">Login</span>   
            </div>
        <% } %>
    </section>

    <!-- other section like contact -->
    <section>
        <a class="contact" href="/contact">Contact with us</a>
    </section>
</body>

<script>
    const login_form = document.querySelector(".login-form");
    const register_form = document.querySelector(".register-form");
    
    const form_div = document.querySelector(".form-div");
    const form = document.getElementById("form");
    const login = document.getElementById("login-toggle");
    const register = document.getElementById("register-toggle");

    const handleFormchanger = async () => {
        if (login.style.display !== "none") {
            login.style.display = "none";
            login_form.style.display = "block";

            register.style.display = "block";
            register_form.style.display = "none";
        }

        else {
            login.style.display = "block";
            login_form.style.display = "none";

            register.style.display = "none";
            register_form.style.display = "block";
        }
    }
</script>

</html>